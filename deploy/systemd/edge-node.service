# Copiar a /etc/systemd/system/edge-node.service
[Unit]
Description=Nodo Edge (M1 + M2) - publicacion en KI-1
Wants=mosquitto.service network-online.target time-sync.target
After=network-online.target mosquitto.service time-sync.target

[Service]
User=elian-trelles
# Único privilegio extra: ajustar el reloj del sistema con la hora del gateway
# cuando no hay NTP (core/clock.py). El nodo no se ejecuta como root.
AmbientCapabilities=CAP_SYS_TIME
WorkingDirectory=/home/elian-trelles/sensado-vehicular
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
