# Copiar a /etc/systemd/system/edge-node.service y ADAPTAR User y WorkingDirectory
# a la instalación real (ver README, "Arranque automático"); por ejemplo:
#   sudo cp deploy/systemd/edge-node.service /etc/systemd/system/
#   sudo systemctl edit --full edge-node      # cambiar User= y WorkingDirectory=
# o, sin editar el archivo, con un drop-in:
#   sudo systemctl edit edge-node
#     [Service]
#     User=pi
#     WorkingDirectory=/home/pi/sensado-vehicular
[Unit]
Description=Nodo Edge (M1 + M2) - publicacion en KI-1
Wants=mosquitto.service network-online.target time-sync.target
After=network-online.target mosquitto.service time-sync.target

[Service]
User=elian-trelles
# Único privilegio extra: ajustar el reloj del sistema con la hora del gateway
# cuando no hay NTP (core/clock.py). El nodo no se ejecuta como root.
AmbientCapabilities=CAP_SYS_TIME
WorkingDirectory=/home/elian-trelles/sensado-vehicular
# Valores operativos EDGE_* (opcional: el "-" permite que no exista).
# Plantilla: deploy/edge-node.env.example
EnvironmentFile=-/etc/edge-node.env
ExecStart=/usr/bin/python3 main.py
Restart=always
RestartSec=5
# Al parar, el nodo vacía su cola interna (EDGE_SHUTDOWN_DRAIN_SECONDS, 10 s por
# defecto) y espera la confirmación MQTT de lo pendiente (5 s): margen de sobra.
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
