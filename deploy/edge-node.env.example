# Variables de entorno del nodo edge (config.py: load_settings).
# Copiar a /etc/edge-node.env y descomentar solo lo que cambie respecto al valor
# por defecto. Un valor no válido detiene el arranque con un mensaje claro
# (journalctl -u edge-node). Los IRIs del proyecto NO son configurables.

# Broker MQTT de KI-1 (por nombre de dominio, nunca por IP). Defecto: localhost
#EDGE_MQTT_HOST=localhost
# Puerto del broker, 1-65535. Defecto: 1883
#EDGE_MQTT_PORT=1883
# client_id MQTT, único por nodo, 1-23 caracteres. Defecto: nodo_edge_moto_01
#EDGE_MQTT_CLIENT_ID=nodo_edge_moto_01

# Bandeja de lo publicado y archivo de observaciones con error (JSON Lines, fsync).
# Rutas relativas al WorkingDirectory del servicio. Deben ser archivos distintos.
#EDGE_OUTBOX_PATH=outbox_ki1.jsonl
#EDGE_ERRORS_PATH=outbox_ki1_errors.jsonl

# Ventana de muestreo del PPD42NS en segundos, (0, 600]. Defecto: 30 (fabricante).
#EDGE_WINDOW_SECONDS=30

# DEBUG | INFO | WARNING | ERROR. Defecto: INFO
#EDGE_LOG_LEVEL=INFO

# Al parar el servicio, segundos para vaciar la cola interna, [0, 120]. Defecto: 10
#EDGE_SHUTDOWN_DRAIN_SECONDS=10
