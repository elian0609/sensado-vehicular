{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://elian0609.github.io/sensado-vehicular/contracts/v2/ki2-response.schema.json",
  "title": "KI-2 v2.0.0 · Respuesta 200 de POST /v1/batch y /v1/batch/raw",
  "description": "ADR-007: siempre 200 cuando el lote se procesa, aunque haya nodos rechazados. Invariante (comprobada por validate_contracts.py): inserted + duplicates + upserted + len(rejected) = batch_size. status = partial si y solo si rejected no está vacío. metrics solo aparece si la petición trae X-Run-Id (experimento, ADR-004).",
  "x-contract-version": "2.0.0",
  "type": "object",
  "required": ["status", "batch_size", "inserted", "duplicates", "upserted", "rejected", "observation_ids"],
  "additionalProperties": false,
  "properties": {
    "status": {"enum": ["ok", "partial"]},
    "batch_size": {"type": "integer", "minimum": 1, "maximum": 500},
    "inserted": {"type": "integer", "minimum": 0},
    "duplicates": {"type": "integer", "minimum": 0},
    "upserted": {"type": "integer", "minimum": 0},
    "rejected": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["index", "reason"],
        "additionalProperties": false,
        "properties": {
          "index": {"type": "integer", "minimum": 0},
          "reason": {"type": "string", "minLength": 1},
          "node_id": {"type": "string"}
        }
      }
    },
    "observation_ids": {
      "description": "IRIs absolutas de las observaciones insertadas o ya existentes (ADR-002).",
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^https://elian0609\\.github\\.io/sensado-vehicular/id/obs/[A-Za-z0-9][A-Za-z0-9_.-]*/[A-Za-z0-9][A-Za-z0-9_.-]*/\\d{8}T\\d{6}Z$"
      }
    },
    "metrics": {
      "type": "object",
      "required": ["run_id", "scenario", "bytes_in", "parse_ms", "annotate_ms", "db_ms", "total_ms"],
      "additionalProperties": false,
      "properties": {
        "run_id": {
          "type": "string",
          "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
        },
        "scenario": {"enum": ["BORDE", "BACKEND"]},
        "bytes_in": {"type": "integer", "minimum": 0},
        "parse_ms": {"type": "number", "minimum": 0},
        "annotate_ms": {"type": "number", "minimum": 0},
        "db_ms": {"type": "number", "minimum": 0},
        "total_ms": {"type": "number", "minimum": 0},
        "cpu_user_ms": {"type": "number", "minimum": 0},
        "cpu_sys_ms": {"type": "number", "minimum": 0},
        "rss_mb": {"type": "number", "minimum": 0}
      }
    }
  },
  "if": {"properties": {"rejected": {"minItems": 1}}},
  "then": {"properties": {"status": {"const": "partial"}}},
  "else": {"properties": {"status": {"const": "ok"}}}
}
